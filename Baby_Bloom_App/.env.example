EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
# Register babybloom://auth/callback as a redirect in Supabase Auth.
# Also register the exact web origin + /auth/callback for each environment.
# Never put a service-role/secret key in an EXPO_PUBLIC variable.
# Android emulator: use http://10.0.2.2:54321; physical device: local LAN IP.

# Optional Vercel server-only AI configuration. Never prefix these names with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
