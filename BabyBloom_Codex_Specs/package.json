{
  "name": "babybloom",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.15.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:vercel": "node --experimental-strip-types scripts/check-deploy-env.mjs && npm run typecheck && npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "format": "prettier --write app src scripts tests package.json app.json tsconfig.json",
    "format:check": "prettier --check app src scripts tests package.json app.json tsconfig.json",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.ts",
    "test:db": "node --experimental-test-isolation=none --test tests/database.test.mjs",
    "test:ui": "jest --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db && npm run test:ui",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file=.env scripts/seed-local.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.generated.ts",
    "test:offline": "node scripts/check-domain.cjs && node --import ./scripts/offline-loader.mjs --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.ts && node --experimental-test-isolation=none --test tests/database.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.23",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-network": "57.0.2",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "19.2.2",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.2",
    "@react-native/jest-preset": "0.86.3",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.6.2",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.ui.test.tsx"
    ]
  }
}
